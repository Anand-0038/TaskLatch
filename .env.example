# Testnet only. Never put a mainnet private key in this file.
# Use separate testnet-only deployer and agent wallets. Keep the agent wallet's
# balance small; it pays gas and can resolve only inside the capped escrow.
# Required for Arc Testnet RPC operations: set the unique endpoint from the Canteen ARC CLI.
# The shared public Arc RPC is intentionally not used as a fallback.
ARC_RPC_URL=
ARC_CHAIN_ID=5042002
API_PORT=8787
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
PROOFPAY_JOB_ID=job-demo-001
ARC_TESTNET_PRIVATE_KEY=
# Optional public buyer address; defaults to the address derived from ARC_TESTNET_PRIVATE_KEY.
PROOFPAY_BUYER_ADDRESS=
ARC_TESTNET_AGENT_PRIVATE_KEY=
PROOFPAY_PROVIDER_PRIVATE_KEY=
PROOFPAY_ESCROW_ADDRESS=
PROOFPAY_PROVIDER_ADDRESS=
PROOFPAY_AGENT_ADDRESS=
VITE_PROOFPAY_ESCROW_ADDRESS=
VITE_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
VITE_PROVIDER_WALLET_ADDRESS=
VITE_PROOFPAY_AGENT_ADDRESS=
VITE_PROOFPAY_JOB_ID=job-demo-001
# Agentic evidence procurement (Circle Agent Wallet and Groq Cloud)
# Complete Circle CLI login and accept its terms yourself before enabling the CLI.
# Circle discovery currently lists Exa x402 on Arc mainnet, not Arc Testnet.
# A separate approved pilot caps evidence calls at $0.10 total; Gateway deposit cap is $0.50.
PROOFPAY_PAID_EVIDENCE_ENABLED=0
CIRCLE_AGENT_WALLET_ADDRESS=
CIRCLE_ACCEPT_TERMS=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
